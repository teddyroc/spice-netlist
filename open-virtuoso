def open_virtuoso(**kwargs) -> Virtuoso:
    """Virtuoso.open()의 별칭"""
    return Virtuoso.open(**kwargs)


def connect_virtuoso(port: int) -> Virtuoso:
    """Virtuoso.connect()의 별칭"""
    return Virtuoso.connect(port)


