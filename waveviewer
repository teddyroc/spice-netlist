class WaveViewSkillbridgeIntegration:
    """
    Integration layer between Skillbridge (Virtuoso) and WaveView.
    
    Automatically displays signals in WaveView as you trace
    through the design hierarchy in Virtuoso.
    
    Usage:
        from skillbridge import Workspace
        
        ws = Workspace()
        wv = WaveViewDriver()
        wv.start(fsdb_path="/path/to/sim.fsdb")
        
        integration = WaveViewSkillbridgeIntegration(ws, wv)
        integration.trace_and_display("top/dut/data[0]")
    """
    
    def __init__(self, skillbridge_ws, waveview: WaveViewDriver):
        """
        Args:
            skillbridge_ws: Skillbridge Workspace instance
            waveview: WaveViewDriver instance
        """
        self.ws = skillbridge_ws
        self.wv = waveview
        self._traced_signals: List[str] = []
        self._current_panel = 0
        
    def trace_and_display(self, signal_path: str, 
                          max_depth: int = 10,
                          highlight_current: bool = True) -> List[str]:
        """
        Trace signal through hierarchy and display all stages in WaveView.
        
        Args:
            signal_path: Starting signal path
            max_depth: Maximum trace depth
            highlight_current: Highlight the most recent signal
            
        Returns:
            List of traced signal paths
        """
        traced = []
        current_signal = signal_path
        
        for depth in range(max_depth):
            # Add to WaveView
            if self.wv.add_signal(current_signal, panel=self._current_panel):
                traced.append(current_signal)
                self._traced_signals.append(current_signal)
                
                # Highlight current
                if highlight_current:
                    # Reset previous highlights
                    for sig in traced[:-1]:
                        self.wv.highlight_signal(sig, "white")
                    self.wv.highlight_signal(current_signal, "yellow")
            
            # Get driver from Skillbridge
            # This assumes your VirtuosoDriver has a method like get_driver()
            driver_info = self._get_driver_from_skill(current_signal)
            
            if driver_info is None:
                break
                
            current_signal = driver_info
        
        self.wv.zoom_fit()
        return traced
    
