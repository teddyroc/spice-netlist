"""
WaveView Driver - Python wrapper for Synopsys Custom WaveView
Controls WaveView via socket communication with embedded Tcl server
"""

import socket
import subprocess
import time
import os
import tempfile
from pathlib import Path
from typing import Optional, List, Union
from dataclasses import dataclass


@dataclass
class WaveViewConfig:
    """Configuration for WaveView connection"""
    host: str = "localhost"
    port: int = 5050
    wv_path: str = "wv"  # Custom WaveView executable
    timeout: float = 10.0
    startup_wait: float = 3.0


class WaveViewDriver:
    """
    Python driver for Synopsys Custom WaveView.
    
    Launches WaveView with an embedded Tcl socket server,
    then sends commands via socket connection.
    
    Usage:
        wv = WaveViewDriver()
        wv.start()
        wv.load_fsdb("/path/to/sim.fsdb")
        wv.add_signal("top.dut.clk")
        wv.add_signal("top.dut.data[7:0]")
        wv.zoom_fit()
        wv.close()
    
    With context manager:
        with WaveViewDriver() as wv:
            wv.load_fsdb("/path/to/sim.fsdb")
            wv.add_signal("top.dut.clk")
    """
    
    def __init__(self, config: Optional[WaveViewConfig] = None):
        self.config = config or WaveViewConfig()
        self._socket: Optional[socket.socket] = None
        self._process: Optional[subprocess.Popen] = None
        self._connected = False
        self._fsdb_loaded: Optional[str] = None
        
    def __enter__(self):
        self.start()
        return self
    
    def __exit__(self, exc_type, exc_val, exc_tb):
        self.close()
        return False
    
    def _create_startup_script(self) -> str:
        """Create Tcl script that starts socket server in WaveView"""
        script = f'''
# WaveView Socket Server Startup Script
# Auto-generated by WaveViewDriver

proc wv_server_start {{port}} {{
    global wv_server_socket
    set wv_server_socket [socket -server wv_accept_client $port]
    puts "WaveView server listening on port $port"
}}

proc wv_accept_client {{sock addr port}} {{
    global wv_client_socket
    set wv_client_socket $sock
    fconfigure $sock -buffering line -blocking 0
    fileevent $sock readable [list wv_handle_command $sock]
    puts "Client connected from $addr:$port"
}}

proc wv_handle_command {{sock}} {{
    if {{[eof $sock]}} {{
        close $sock
        puts "Client disconnected"
        return
    }}
    
    gets $sock cmd
    if {{$cmd eq ""}} {{
        return
    }}
    
    # Execute command and capture result
    if {{[catch {{set result [uplevel #0 $cmd]}} err]}} {{
        puts $sock "ERROR: $err"
    }} else {{
        if {{$result eq ""}} {{
            puts $sock "OK"
        }} else {{
            puts $sock "OK: $result"
        }}
    }}
}}

proc wv_server_stop {{}} {{
    global wv_server_socket
    if {{[info exists wv_server_socket]}} {{
        close $wv_server_socket
        puts "WaveView server stopped"
    }}
}}

# Start server on port {self.config.port}
wv_server_start {self.config.port}
'''
        # Write to temp file
        fd, path = tempfile.mkstemp(suffix='.tcl', prefix='wv_server_')
        with os.fdopen(fd, 'w') as f:
            f.write(script)
        return path
    
    def start(self, fsdb_path: Optional[str] = None) -> bool:
        """
        Start WaveView with socket server.
        
        Args:
            fsdb_path: Optional FSDB file to load on startup
            
        Returns:
            True if started successfully
        """
        if self._connected:
            return True
            
        # Create startup script
        script_path = self._create_startup_script()
        
        try:
            # Build command
            cmd = [self.config.wv_path, '-ace_tcl_gui', script_path]
            if fsdb_path:
                cmd.extend(['-ssf', fsdb_path])
            
            # Start WaveView process
            self._process = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                start_new_session=True
            )
            
            # Wait for startup
            time.sleep(self.config.startup_wait)
            
            # Connect socket
            self._connect()
            
            if fsdb_path:
                self._fsdb_loaded = fsdb_path
                
            return True
            
        except Exception as e:
            print(f"Failed to start WaveView: {e}")
            return False
        finally:
            # Cleanup temp script
            try:
                os.unlink(script_path)
            except:
                pass
    
    def _connect(self) -> bool:
        """Establish socket connection to WaveView"""
        if self._connected:
            return True
            
        try:
            self._socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            self._socket.settimeout(self.config.timeout)
            self._socket.connect((self.config.host, self.config.port))
            self._connected = True
            return True
        except Exception as e:
            print(f"Connection failed: {e}")
            self._socket = None
            return False
    
    def connect_existing(self, host: str = "localhost", port: int = 5050) -> bool:
        """
        Connect to an already running WaveView instance with socket server.
        
        Args:
            host: WaveView host
            port: Socket server port
            
        Returns:
            True if connected successfully
        """
        self.config.host = host
        self.config.port = port
        return self._connect()
    
    def _send_command(self, cmd: str) -> str:
        """
        Send Tcl command to WaveView and get response.
        
        Args:
            cmd: Tcl command string
            
        Returns:
            Response string from WaveView
        """
        if not self._connected:
            raise ConnectionError("Not connected to WaveView")
        
        try:
            self._socket.sendall((cmd + '\n').encode('utf-8'))
            response = self._socket.recv(4096).decode('utf-8').strip()
            return response
        except Exception as e:
            raise ConnectionError(f"Command failed: {e}")
    
    def tcl(self, cmd: str) -> str:
        """
        Execute raw Tcl command.
        
        Args:
            cmd: Raw Tcl command
            
        Returns:
            Command response
        """
        return self._send_command(cmd)
    
    # ========== FSDB Operations ==========
    
    def load_fsdb(self, path: str, alias: Optional[str] = None) -> bool:
        """
        Load FSDB file.
        
        Args:
            path: Path to FSDB file
            alias: Optional alias for the database
            
        Returns:
            True if loaded successfully
        """
        path = os.path.abspath(path)
        if not os.path.exists(path):
            raise FileNotFoundError(f"FSDB file not found: {path}")
        
        cmd = f'wvOpenFile "{path}"'
        if alias:
            cmd = f'wvOpenFile "{path}" -alias "{alias}"'
            
        result = self._send_command(cmd)
        if "ERROR" not in result:
            self._fsdb_loaded = path
            return True
        return False
    
    def close_fsdb(self) -> bool:
        """Close current FSDB file"""
        result = self._send_command('wvCloseFile')
        if "ERROR" not in result:
            self._fsdb_loaded = None
            return True
        return False
    
    # ========== Signal Operations ==========
    
    def add_signal(self, signal_path: str, panel: int = 0) -> bool:
        """
        Add signal to waveform display.
        
        Args:
            signal_path: Full hierarchical signal path (e.g., "top.dut.clk")
            panel: Panel index to add signal to
            
        Returns:
            True if added successfully
        """
        # Convert dot notation to WaveView format if needed
        sig = signal_path.replace('.', '/')
        if not sig.startswith('/'):
            sig = '/' + sig
            
        cmd = f'wvAddSignal -panel {panel} "{sig}"'
        result = self._send_command(cmd)
        return "ERROR" not in result
    
    def add_signals(self, signal_paths: List[str], panel: int = 0) -> int:
        """
        Add multiple signals to waveform display.
        
        Args:
            signal_paths: List of signal paths
            panel: Panel index
            
        Returns:
            Number of signals successfully added
        """
        count = 0
        for sig in signal_paths:
            if self.add_signal(sig, panel):
                count += 1
        return count
    
    def add_signal_by_pattern(self, pattern: str, panel: int = 0) -> bool:
        """
        Add signals matching pattern.
        
        Args:
            pattern: Wildcard pattern (e.g., "top/dut/data*")
            panel: Panel index
            
        Returns:
            True if command executed successfully
        """
        cmd = f'wvAddSignal -panel {panel} -pattern "{pattern}"'
        result = self._send_command(cmd)
        return "ERROR" not in result
    
    def remove_signal(self, signal_path: str) -> bool:
        """Remove signal from display"""
        sig = signal_path.replace('.', '/')
        if not sig.startswith('/'):
            sig = '/' + sig
        cmd = f'wvRemoveSignal "{sig}"'
        result = self._send_command(cmd)
        return "ERROR" not in result
    
    def clear_signals(self, panel: Optional[int] = None) -> bool:
        """
        Clear all signals from display.
        
        Args:
            panel: Specific panel to clear, or None for all
        """
        if panel is not None:
            cmd = f'wvClearPanel {panel}'
        else:
            cmd = 'wvClearAll'
        result = self._send_command(cmd)
        return "ERROR" not in result
    
    def highlight_signal(self, signal_path: str, color: str = "red") -> bool:
        """
        Highlight a signal with specified color.
        
        Args:
            signal_path: Signal to highlight
            color: Color name (red, green, blue, yellow, etc.)
        """
        sig = signal_path.replace('.', '/')
        if not sig.startswith('/'):
            sig = '/' + sig
        cmd = f'wvSetSignalColor "{sig}" {color}'
        result = self._send_command(cmd)
        return "ERROR" not in result
    
    # ========== View Operations ==========
    
    def zoom_fit(self) -> bool:
        """Zoom to fit all waveforms"""
        result = self._send_command('wvZoomFit')
        return "ERROR" not in result
    
    def zoom_in(self) -> bool:
        """Zoom in"""
        result = self._send_command('wvZoomIn')
        return "ERROR" not in result
    
    def zoom_out(self) -> bool:
        """Zoom out"""
        result = self._send_command('wvZoomOut')
        return "ERROR" not in result
    
    def zoom_range(self, start_time: float, end_time: float, unit: str = "ns") -> bool:
        """
        Zoom to specific time range.
        
        Args:
            start_time: Start time
            end_time: End time
            unit: Time unit (ps, ns, us, ms, s)
        """
        cmd = f'wvZoomRange {start_time}{unit} {end_time}{unit}'
        result = self._send_command(cmd)
        return "ERROR" not in result
    
    def set_cursor(self, time: float, unit: str = "ns", cursor_id: int = 1) -> bool:
        """
        Set cursor to specific time.
        
        Args:
            time: Time value
            unit: Time unit
            cursor_id: Cursor index (1 or 2)
        """
        cmd = f'wvSetCursor {cursor_id} {time}{unit}'
        result = self._send_command(cmd)
        return "ERROR" not in result
    
    def scroll_to_time(self, time: float, unit: str = "ns") -> bool:
        """Scroll view to center on specified time"""
        cmd = f'wvScrollToTime {time}{unit}'
        result = self._send_command(cmd)
        return "ERROR" not in result
    
    # ========== Panel Operations ==========
    
    def create_panel(self, name: Optional[str] = None) -> int:
        """
        Create new waveform panel.
        
        Args:
            name: Optional panel name
            
        Returns:
            Panel index, or -1 on failure
        """
        if name:
            cmd = f'wvCreatePanel -name "{name}"'
        else:
            cmd = 'wvCreatePanel'
        result = self._send_command(cmd)
        if "ERROR" not in result:
            try:
                # Extract panel index from response
                return int(result.split()[-1])
            except:
                return 0
        return -1
    
    def delete_panel(self, panel: int) -> bool:
        """Delete panel by index"""
        cmd = f'wvDeletePanel {panel}'
        result = self._send_command(cmd)
        return "ERROR" not in result
    
    # ========== Marker/Annotation Operations ==========
    
    def add_marker(self, time: float, label: str = "", unit: str = "ns") -> bool:
        """Add time marker"""
        cmd = f'wvAddMarker {time}{unit}'
        if label:
            cmd += f' -label "{label}"'
        result = self._send_command(cmd)
        return "ERROR" not in result
    
    def clear_markers(self) -> bool:
        """Clear all markers"""
        result = self._send_command('wvClearMarkers')
        return "ERROR" not in result
    
    # ========== Export Operations ==========
    
    def export_image(self, path: str, format: str = "png") -> bool:
        """
        Export waveform view as image.
        
        Args:
            path: Output file path
            format: Image format (png, jpg, bmp)
        """
        path = os.path.abspath(path)
        cmd = f'wvExportImage "{path}" -format {format}'
        result = self._send_command(cmd)
        return "ERROR" not in result
    
    def save_session(self, path: str) -> bool:
        """Save current session"""
        path = os.path.abspath(path)
        cmd = f'wvSaveSession "{path}"'
        result = self._send_command(cmd)
        return "ERROR" not in result
    
    def load_session(self, path: str) -> bool:
        """Load saved session"""
        path = os.path.abspath(path)
        cmd = f'wvLoadSession "{path}"'
        result = self._send_command(cmd)
        return "ERROR" not in result
    
    # ========== Measurement Operations ==========
    
    def measure_rise_time(self, signal_path: str) -> Optional[float]:
        """Measure rise time of signal"""
        sig = signal_path.replace('.', '/')
        if not sig.startswith('/'):
            sig = '/' + sig
        cmd = f'wvMeasure -signal "{sig}" -type rise_time'
        result = self._send_command(cmd)
        if "ERROR" not in result:
            try:
                return float(result.split()[-1])
            except:
                return None
        return None
    
    def measure_fall_time(self, signal_path: str) -> Optional[float]:
        """Measure fall time of signal"""
        sig = signal_path.replace('.', '/')
        if not sig.startswith('/'):
            sig = '/' + sig
        cmd = f'wvMeasure -signal "{sig}" -type fall_time'
        result = self._send_command(cmd)
        if "ERROR" not in result:
            try:
                return float(result.split()[-1])
            except:
                return None
        return None
    
    def measure_frequency(self, signal_path: str) -> Optional[float]:
        """Measure frequency of signal"""
        sig = signal_path.replace('.', '/')
        if not sig.startswith('/'):
            sig = '/' + sig
        cmd = f'wvMeasure -signal "{sig}" -type frequency'
        result = self._send_command(cmd)
        if "ERROR" not in result:
            try:
                return float(result.split()[-1])
            except:
                return None
        return None
    
    # ========== Connection Management ==========
    
    def is_connected(self) -> bool:
        """Check if connected to WaveView"""
        return self._connected
    
    def close(self):
        """Close connection and optionally terminate WaveView"""
        if self._socket:
            try:
                self._send_command('wv_server_stop')
            except:
                pass
            try:
                self._socket.close()
            except:
                pass
            self._socket = None
            
        self._connected = False
        
        if self._process:
            try:
                self._process.terminate()
                self._process.wait(timeout=5)
            except:
                self._process.kill()
            self._process = None
    
    def quit_waveview(self):
        """Quit WaveView application"""
        try:
            self._send_command('wvExit')
        except:
            pass
        self.close()


