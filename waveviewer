    def new_trace_panel(self, name: Optional[str] = None) -> int:
        """Create new panel for a new trace session"""
        panel = self.wv.create_panel(name)
        if panel >= 0:
            self._current_panel = panel
        return panel
    
    def clear_trace(self):
        """Clear all traced signals"""
        self.wv.clear_signals(self._current_panel)
        self._traced_signals.clear()
    
    def get_traced_signals(self) -> List[str]:
        """Get list of all traced signals"""
        return self._traced_signals.copy()


# ========== Convenience Functions ==========

def quick_view(fsdb_path: str, signals: List[str], 
               wv_path: str = "wv") -> WaveViewDriver:
    """
    Quick helper to open FSDB and display signals.
    
    Args:
        fsdb_path: Path to FSDB file
        signals: List of signals to display
        wv_path: Path to WaveView executable
        
    Returns:
        WaveViewDriver instance (remember to close it!)
    """
    config = WaveViewConfig(wv_path=wv_path)
    wv = WaveViewDriver(config)
    wv.start(fsdb_path)
    wv.add_signals(signals)
    wv.zoom_fit()
    return wv


